@page "/"
@inject PumpStatus Pump
@inject UpdateService Updater
@inject ConfigService ConfigSvc
@implements IDisposable

<PageTitle>Status — Gundi Radio Service</PageTitle>

@if (_unconfigured)
{
    @*
        First-run banner. Surfaces the wizard prominently when the
        service has nothing useful to do yet (no reader type set, or
        no destinations configured). Goes away the moment the operator
        finishes Setup and we get a config with both halves filled in.
    *@
    <div class="card setup-cta">
        <h2>Welcome — let's get the service running</h2>
        <p>
            The Gundi Radio Service is installed but not yet configured.
            The setup wizard will walk you through pointing it at your
            source database and adding at least one Gundi destination.
        </p>
        <a href="/setup" class="primary-button">Set up the service</a>
    </div>
}

<div class="card">
    <h2>Pump status</h2>
    <div class="stat">
        <span class="stat-label">State</span>
        <span class="stat-value">
            @if (Pump.IsPaused)
            {
                <span class="badge badge-paused">Paused</span>
            }
            else if (Pump.IsRunning)
            {
                <span class="badge badge-running">Running</span>
            }
            else
            {
                <span class="badge badge-stopped">Stopped</span>
            }
        </span>
    </div>
    <div class="stat">
        <span class="stat-label">Version</span>
        <span class="stat-value">@Pump.Version</span>
    </div>
    <div class="stat">
        <span class="stat-label">Started</span>
        <span class="stat-value">@FormatTimestamp(Pump.StartedAt) (@Ago(Pump.StartedAt))</span>
    </div>
    @if (Pump.LastError is not null)
    {
        <div class="error">
            <div class="error-header">
                <strong>Last error</strong>
                <button type="button" class="dismiss" title="Dismiss this error notice"
                        @onclick="OnDismissError">×</button>
            </div>
            <div class="error-body">@Pump.LastError</div>
        </div>
    }

    <div style="margin-top: 1rem;">
        <button @onclick="OnTogglePause">
            @(Pump.IsPaused ? "Resume" : "Pause")
        </button>
    </div>
</div>

<div class="card">
    <h2>Last batch</h2>
    @if (Pump.LastBatchAt is null)
    {
        <p style="color: #888; font-style: italic;">No batches sent yet.</p>
    }
    else
    {
        <div class="stat">
            <span class="stat-label">When</span>
            <span class="stat-value">@FormatTimestamp(Pump.LastBatchAt!.Value) (@Ago(Pump.LastBatchAt!.Value))</span>
        </div>
        <div class="stat">
            <span class="stat-label">Records</span>
            <span class="stat-value">@Pump.LastBatchCount</span>
        </div>
        <div class="stat">
            <span class="stat-label">Cursor</span>
            <span class="stat-value">@(Pump.LastCursor ?? "—")</span>
        </div>
    }
</div>

<div class="card">
    <h2>Totals since start</h2>
    <div class="stat">
        <span class="stat-label">Batches</span>
        <span class="stat-value">@Pump.TotalBatches.ToString("N0")</span>
    </div>
    <div class="stat">
        <span class="stat-label">Records</span>
        <span class="stat-value">@Pump.TotalRecords.ToString("N0")</span>
    </div>
</div>

<div class="card">
    <h2>Updates</h2>
    <div class="stat">
        <span class="stat-label">Current version</span>
        <span class="stat-value">@Updater.CurrentVersion</span>
    </div>
    @if (!Updater.IsInstalled)
    {
        <p class="hint" style="margin-top: 0.75rem;">
            Updates are unavailable in this build (running from source or
            outside a Velopack install).
        </p>
    }
    else
    {
        <div style="margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button @onclick="OnCheckForUpdate" disabled="@(_checking || _applying)">
                @(_checking ? "Checking…" : "Check for updates")
            </button>
            @if (_check is { HasUpdate: true } u)
            {
                <button @onclick="OnApplyUpdate" disabled="@_applying" class="primary">
                    @(_applying ? "Updating…" : $"Update to {u.AvailableVersion}")
                </button>
            }
            @if (_applyMessage is not null)
            {
                <span class="@(_applySuccess ? "saved-msg" : "error-msg")">@_applyMessage</span>
            }
            else if (_check is { } c)
            {
                @if (c.UpToDate)
                {
                    <span class="saved-msg">✓ Up to date.</span>
                }
                else if (c.Error is not null)
                {
                    <span class="error-msg">✗ @c.Error</span>
                }
            }
        </div>
    }
</div>

<div class="card">
    <h2>Support</h2>
    <p class="hint" style="margin-bottom: 1rem;">
        If you need help, download a diagnostic bundle and email it to your
        support contact. The bundle includes the log file, the current
        configuration (with passwords and API keys redacted), the cursor
        state, and a short metadata file.
    </p>
    <a href="/api/diagnostic-bundle" class="primary-button" download>
        Download diagnostic bundle
    </a>
</div>

<style>
    .saved-msg { color: #155724; background: #d4edda; padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.9rem; }
    .error-msg { color: #721c24; background: #f8d7da; padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.9rem; }
    .hint { color: #888; font-size: 0.9rem; margin: 0; }
    a.primary-button { display: inline-block; background: #0071e3; color: white; padding: 0.5rem 1.25rem; border-radius: 6px; text-decoration: none; font-size: 0.95rem; }
    a.primary-button:hover { background: #0077ed; }
    .setup-cta { background: #fff8e1; border: 1px solid #ffe082; }
    .setup-cta h2 { color: #5d4037; }
    .setup-cta p { line-height: 1.5; margin: 0.5rem 0 1rem; }
</style>

@code {
    private UpdateCheckOutcome? _check;
    private bool _checking;
    private bool _applying;
    private string? _applyMessage;
    private bool _applySuccess;

    // Drives the relative-time labels ("5s ago" -> "6s ago" -> ...) between
    // PumpStatus.Changed events. Without this, those strings only refresh
    // when a batch actually fires, so the page looks frozen during quiet
    // moments. Cost is one cross-thread StateHasChanged per second; Blazor
    // Server's diff mechanism turns "no changes" into a no-op on the wire.
    private System.Threading.Timer? _ticker;

    // True when we've never been pointed at a real database or have no
    // destinations to send to -- in either case the pump can't do
    // anything useful and the operator should be nudged to /setup.
    // Recomputed on each status change so finishing the wizard makes
    // the CTA disappear without needing a hard page refresh.
    private bool _unconfigured;

    protected override void OnInitialized()
    {
        RefreshUnconfigured();
        Pump.Changed += OnStatusChanged;
        _ticker = new System.Threading.Timer(
            _ => OnStatusChanged(),
            state: null,
            dueTime: TimeSpan.FromSeconds(1),
            period: TimeSpan.FromSeconds(1));
    }

    private void RefreshUnconfigured()
    {
        var cfg = ConfigSvc.LoadRouteConfig();
        _unconfigured = cfg.DatabaseType is null
                        || (cfg.gundiConnections?.Count ?? 0) == 0;
    }

    private void OnStatusChanged()
    {
        // Fire-and-forget the dispatcher invocation. async-void here would
        // let an exception in StateHasChanged escape the event-callback
        // frame and tear down the Blazor circuit; assigning to discard
        // keeps it as a Task whose faults route through Blazor's normal
        // unhandled-task handling.
        _ = InvokeAsync(() =>
        {
            RefreshUnconfigured();
            StateHasChanged();
        });
    }

    private void OnTogglePause()
    {
        Pump.TogglePause();
    }

    private void OnDismissError()
    {
        Pump.ClearError();
    }

    private async Task OnCheckForUpdate()
    {
        _checking = true;
        _applyMessage = null;
        try
        {
            _check = await Updater.CheckAsync();
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task OnApplyUpdate()
    {
        _applying = true;
        _applyMessage = null;
        try
        {
            // Recovery from the inevitable circuit loss is handled by the
            // reconnect modal in _Host.cshtml: when Blazor gives up
            // reconnecting (the server-side circuit is destroyed when the
            // service restarts and can't be reattached), the operator
            // sees a "Refresh page" button. No work to do here beyond
            // kicking off the apply and surfacing the response.
            var outcome = await Updater.ApplyAsync();
            _applyMessage = outcome.Message;
            _applySuccess = outcome.Success;
        }
        finally
        {
            _applying = false;
        }
    }

    private string FormatTimestamp(DateTime utc)
        => utc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s ago";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    public void Dispose()
    {
        Pump.Changed -= OnStatusChanged;
        _ticker?.Dispose();
    }
}
