@page "/_Host"
@namespace service.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gundi Radio Service</title>
    <base href="~/" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    @*
        Disable Blazor's auto-start so we can configure the SignalR
        client's reconnect policy before it kicks off. Default policy
        is 8 attempts with exponential backoff topping out around
        ~30 seconds; that's not enough to ride out a Velopack update,
        which can take longer than that between "old service stops"
        and "new service binds 8080" (Update.exe's swap, the post-
        hook scan, our orchestrator's sc start, SCM's launch).

        Custom policy: keep retrying for ~3 minutes with a backoff
        that caps at 5 seconds, so an idle operator's tab reconnects
        on its own instead of leaving them staring at the "Update
        downloaded" message wondering if it worked.
    *@
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
        // Helper used by Status.razor's "Apply update" handler. Schedules
        // a hard reload independent of the SignalR circuit's lifetime.
        //
        // Why we need this: Blazor Server keeps per-tab UI state (the
        // "circuit") on the server. When the service restarts for an
        // update, every circuit is destroyed; even after the SignalR
        // transport successfully reconnects to the new server, the
        // circuit reattach step fails because the new server has no
        // memory of the old circuit ID. Default Blazor UI is a small
        // "Reload" link, which operators miss. A scheduled
        // window.location.reload() runs from the BROWSER's setTimeout
        // and fires regardless of what happens to the circuit, so the
        // page recovers automatically.
        window.scheduleReload = function (delayMs) {
            setTimeout(function () { window.location.reload(); }, delayMs);
        };

        Blazor.start({
            reconnectionOptions: {
                // Generous retry window for the WebSocket reconnect. The
                // circuit-reattach problem is handled separately via the
                // scheduleReload helper above, but a wider retry window
                // here helps for scenarios that AREN'T a service restart
                // (brief network blip, machine sleep, etc.) where the
                // circuit IS still alive on the server.
                maxRetries: 60,
                retryIntervalMilliseconds: function (attempt) {
                    return Math.min(attempt * 1000, 5000);
                }
            }
        });
    </script>
</body>
</html>
