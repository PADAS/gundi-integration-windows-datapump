@page "/setup"
@using System.ComponentModel.DataAnnotations
@inject ConfigService ConfigSvc
@inject PumpController Controller
@inject NavigationManager Nav

<PageTitle>Setup — Gundi Radio Service</PageTitle>

@*
    First-run wizard. Walks a fresh installer through the minimum
    viable configuration: the source database, then any number of
    Gundi destinations (zero is OK -- the operator may pause here
    to fetch an API key and come back). On finish it persists to
    appsettings.json and triggers a hot-reload, the same path the
    manual Configuration page uses.

    Round-trips the same DbFormModel / DestinationFormModel /
    GroupAliasFormModel that Config.razor uses so behaviour matches
    the manual page exactly. Step UI is intentionally minimal:
    monochrome cards, no progress bar, just a "Back" / "Next" pair
    at the bottom of each step. Test Connection is a soft gate --
    we encourage the operator to use it but don't block Next.
*@

<div class="card setup-card">
    <div class="step-header">
        <span class="step-counter">Step @_step of 4</span>
        <h2>@StepTitle()</h2>
    </div>

    @if (_step == 1)
    {
        <div class="welcome">
            <p>This wizard will help you configure the Gundi Radio Service. We'll walk through:</p>
            <ul class="welcome-bullets">
                <li>The <strong>source database</strong> the service reads radio location data from.</li>
                <li>One or more <strong>Gundi destinations</strong> the service forwards observations to.</li>
                <li>A quick <strong>verification step</strong> before saving, so you don't have to dig through logs to find out a typo broke the pump.</li>
            </ul>
            <p class="hint">You can skip the destinations step and come back later (e.g., if you still need to fetch an API key from Gundi). The pump will idle until at least one destination is configured.</p>
        </div>

        <div class="nav-actions">
            <button type="button" class="secondary" @onclick="OnBack">Cancel</button>
            <button type="button" @onclick="OnWelcomeNext">Get started</button>
        </div>
    }
    else if (_step == 2)
    {
        <EditForm Model="@_dbForm" OnValidSubmit="OnDatabaseStepNext">
            <DataAnnotationsValidator />

            <div class="field">
                <label>Reader type</label>
                <InputSelect @bind-Value="_dbForm.ReaderTypeValue" class="input">
                    <option value="-1">— select —</option>
                    @foreach (var r in service.RadioDataPumpService.supportedReaders)
                    {
                        <option value="@((int)r.Type)">@r.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => _dbForm.ReaderTypeValue)" />
            </div>

            <div class="field">
                <label>Hostname</label>
                <InputText @bind-Value="_dbForm.Hostname" class="input" placeholder="localhost" />
                <ValidationMessage For="@(() => _dbForm.Hostname)" />
            </div>

            <div class="field">
                <label>Database name</label>
                <InputText @bind-Value="_dbForm.DatabaseName" class="input" />
                <ValidationMessage For="@(() => _dbForm.DatabaseName)" />
            </div>

            <div class="field">
                <label>Username</label>
                <InputText @bind-Value="_dbForm.Username" class="input" />
                <ValidationMessage For="@(() => _dbForm.Username)" />
            </div>

            <div class="field">
                <label>Password</label>
                <InputText @bind-Value="_dbForm.NewPassword" class="input" type="password" />
            </div>

            <div class="field">
                <label>Schema <small class="hint">(PostgreSQL readers only)</small></label>
                <InputText @bind-Value="_dbForm.DatabaseSchema" class="input" placeholder="public" />
            </div>

            <div class="step-actions">
                <button type="button" class="secondary" @onclick="OnTestConnection" disabled="@_testing">
                    @(_testing ? "Testing…" : "Test connection")
                </button>
                @if (_testResult is not null)
                {
                    <span class="@(_testResult.Success ? "saved-msg" : "error-msg")">
                        @(_testResult.Success ? "✓" : "✗") @_testResult.Message
                    </span>
                }
            </div>

            <div class="nav-actions">
                <button type="button" class="secondary" @onclick="OnBack">Back</button>
                <button type="submit">Next</button>
            </div>
        </EditForm>
    }
    else if (_step == 3)
    {
        <p class="hint" style="margin-top: 0;">
            Add the Gundi or EarthRanger destinations the pump should forward observations to.
            You can add zero destinations now and come back later from the Configuration page;
            the pump will idle until at least one destination is configured.
        </p>

        @if (_destinations.Count == 0)
        {
            <p style="color: #888; font-style: italic;">No destinations yet.</p>
        }
        else
        {
            @*
                @key keys each card by the destination model instance so
                that picker open-state and focus survive add/remove of
                other cards. Without it, an index-based render identity
                would "shift" UI state to the wrong card when the
                operator removes an earlier destination.

                _pickerOpenForDest is also tracked by instance reference
                (DestinationFormModel?, not int?) for the same reason --
                index would drift, instance reference is stable.
            *@
            @for (int i = 0; i < _destinations.Count; i++)
            {
                int idx = i;
                var dest = _destinations[idx];
                <DestinationCard @key="dest"
                    Dest="dest"
                    PickerOpen="_pickerOpenForDest == dest"
                    FetchingAliases="_fetchingAliases"
                    AliasFetchError="_aliasFetchError"
                    AvailableAliases="_availableAliases"
                    SendEverythingDetail="Leave on for typical setups. Turn off to forward only specific radio groups using the alias list below."
                    OnRemove="() => OnRemoveDestination(idx)"
                    OnTestApiKey="() => OnTestApiKey(idx)"
                    OnAddAlias="() => OnAddAlias(idx)"
                    OnRemoveAlias="(j) => OnRemoveAlias(idx, j)"
                    OnOpenPicker="() => OnOpenPicker(dest)"
                    OnClosePicker="OnClosePicker"
                    OnTogglePickedAlias="(avail) => OnTogglePickedAlias(idx, avail)"
                />
            }
        }

        <button type="button" class="secondary" @onclick="OnAddDestination" style="margin-top: 0.5rem;">
            + Add destination
        </button>

        @if (_destinationErrors.Count > 0)
        {
            <div class="error-list">
                @foreach (var err in _destinationErrors)
                {
                    <div class="error-msg">@err</div>
                }
            </div>
        }

        <div class="nav-actions">
            <button type="button" class="secondary" @onclick="OnBack">Back</button>
            <button type="button" @onclick="OnDestinationsStepNext">Next</button>
        </div>
    }
    else if (_step == 4)
    {
        <p>Ready to save:</p>
        <ul class="summary">
            <li><strong>Reader type:</strong> @ReaderName(_dbForm.ReaderTypeValue)</li>
            <li><strong>Database:</strong> @_dbForm.Username@@@_dbForm.Hostname/@_dbForm.DatabaseName</li>
            <li><strong>Destinations:</strong>
                @if (_destinations.Count == 0)
                {
                    <em>none yet — pump will idle until you add one.</em>
                }
                else
                {
                    @($"{_destinations.Count} configured")
                }
            </li>
        </ul>

        @if (_saveError is not null)
        {
            <div class="error-msg" style="margin-top: 0.75rem;">@_saveError</div>
        }

        <div class="nav-actions">
            <button type="button" class="secondary" @onclick="OnBack" disabled="@_saving">Back</button>
            <button type="button" @onclick="OnFinish" disabled="@_saving">
                @(_saving ? "Saving…" : "Finish")
            </button>
        </div>
    }
</div>

<style>
    /* Wizard-specific. Form primitives, destination-card, and alias
       picker styles all live in MainLayout.razor's global block since
       they're shared with the manual Configuration page. */
    .setup-card { max-width: 720px; margin: 0 auto; }
    .step-header { margin-bottom: 1.25rem; }
    .step-header h2 { margin: 0; }
    .step-counter { display: block; color: #888; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
    .welcome p { line-height: 1.5; }
    .welcome-bullets { line-height: 1.6; padding-left: 1.25rem; }
    .step-actions { margin-top: 1rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
    .nav-actions { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid #eee; display: flex; justify-content: space-between; gap: 0.75rem; }
    .summary { line-height: 1.7; }
</style>

@code {
    private int _step = 1;
    private DbFormModel _dbForm = new();
    private List<DestinationFormModel> _destinations = new();
    private List<string> _destinationErrors = new();
    private bool _testing;
    private TestResult? _testResult;
    private bool _saving;
    private string? _saveError;

    // Group-alias picker state, scoped to the page rather than per-
    // destination because all destinations share a single source DB --
    // no point fetching once per destination card. Same shape used in
    // Config.razor; this duplication is deliberate-but-unfortunate, and
    // a candidate for extraction into a shared component when the
    // wizard and the manual page next get refactored together.
    private List<GroupAlias>? _availableAliases;   // null = not yet fetched
    private string? _aliasFetchError;
    private bool _fetchingAliases;
    // Tracked by instance reference rather than list index because the
    // operator can add/remove destinations while the picker is open;
    // an index would drift, an instance reference doesn't.
    private DestinationFormModel? _pickerOpenForDest;

    // Cache-generation token. Bumped by ClearTransientStepState whenever
    // the operator leaves step 3 (or returns to it). EnsureAliasesFetched
    // captures the current value before kicking off its DB query and
    // refuses to write its result if the value has changed by the time
    // the query returns -- so an in-flight fetch that the operator
    // navigated away from doesn't repopulate the cache with stale data.
    private int _fetchGeneration;

    protected override void OnInitialized()
    {
        // Pre-populate from whatever is in appsettings.json today, so an
        // operator who half-completed setup last time picks up where they
        // left off rather than starting over. New installs see a fresh
        // form because LoadRouteConfig returns a default RouteConfiguration
        // when the section is missing.
        var current = ConfigSvc.LoadRouteConfig();
        _dbForm = DbFormModel.From(current);
        _destinations = (current.gundiConnections ?? new())
            .Select(DestinationFormModel.From)
            .ToList();
    }

    private string StepTitle() => _step switch
    {
        1 => "Welcome",
        2 => "Source database",
        3 => "Gundi destinations",
        4 => "Review & save",
        _ => "",
    };

    private string ReaderName(int value)
    {
        var reader = service.RadioDataPumpService.supportedReaders
            .FirstOrDefault(r => (int)r.Type == value);
        return reader?.Name ?? "(not selected)";
    }

    private void OnBack()
    {
        if (_step == 1)
        {
            // Step 1 has no "previous" page in the wizard; send the user
            // to the Status page so the back action is never a no-op.
            Nav.NavigateTo("/");
            return;
        }
        _step--;
        ClearTransientStepState();
    }

    private void OnNext()
    {
        _step++;
        ClearTransientStepState();
    }

    /// <summary>
    /// Reset the per-step ephemeral fields that shouldn't carry over a
    /// step transition. Includes the alias picker's open state and
    /// cached results -- without that reset, an operator who opens the
    /// picker on step 3, navigates back to step 2 to tweak DB
    /// settings, then comes forward again, would see the picker still
    /// open with stale results that don't reflect the new DB form.
    /// </summary>
    private void ClearTransientStepState()
    {
        _testResult = null;
        _saveError = null;
        _destinationErrors.Clear();
        _pickerOpenForDest = null;
        _availableAliases = null;
        _aliasFetchError = null;

        // Bump the fetch generation so any in-flight EnsureAliasesFetched
        // that hasn't returned yet will discard its result rather than
        // repopulate the cache we just cleared. _fetchingAliases is left
        // alone -- the in-flight fetch's finally block will reset it.
        _fetchGeneration++;
    }

    // Step 1: Welcome -> Database
    private void OnWelcomeNext() => OnNext();

    // Step 2: Database. OnValidSubmit fires only when DataAnnotations pass.
    // Test Connection is a soft gate -- we don't refuse Next on a failed
    // probe, but the user has seen the result and chosen to proceed.
    private void OnDatabaseStepNext()
    {
        OnNext();
    }

    // Step 3: Destinations. Validate (same rules as Config.razor) but
    // allow zero destinations -- the operator may legitimately pause here.
    private void OnDestinationsStepNext()
    {
        _destinationErrors = ValidateDestinations(_destinations);
        if (_destinationErrors.Count > 0) return;
        OnNext();
    }

    // Step 4: Save. Same persistence path as Config.razor's OnSave.
    private async Task OnFinish()
    {
        _saving = true;
        _saveError = null;
        try
        {
            var existing = ConfigSvc.LoadRouteConfig();
            RouteConfiguration updated;
            try
            {
                updated = _dbForm.ToRouteConfig(existingPassword: existing.Password);
            }
            catch (InvalidOperationException ex)
            {
                _saveError = ex.Message;
                _step = 2;  // bounce back to the database step
                return;
            }
            updated.gundiConnections = _destinations.Select(d => d.ToConnection()).ToList();

            ConfigSvc.SaveRouteConfig(updated);
            Controller.RequestReload();

            // Brief pause so the operator sees the "Saving..." flash --
            // SaveRouteConfig and RequestReload return synchronously and
            // a 0ms transition feels like the button didn't do anything.
            await Task.Delay(250);

            Nav.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            _saveError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnAddDestination()
    {
        _destinations.Add(new DestinationFormModel());
        _destinationErrors.Clear();
    }

    private void OnRemoveDestination(int index)
    {
        if (index < 0 || index >= _destinations.Count) return;
        var removed = _destinations[index];
        _destinations.RemoveAt(index);
        // If the operator removes the destination whose picker is open,
        // null out _pickerOpenForDest so it doesn't dangle as a stale
        // reference -- otherwise the next OnOpenPicker won't take its
        // "no picker open" code path on the new card.
        if (ReferenceEquals(_pickerOpenForDest, removed)) _pickerOpenForDest = null;
        _destinationErrors.Clear();
    }

    private async Task OnTestConnection()
    {
        _testResult = null;
        if (_dbForm.ReaderTypeValue < 0)
        {
            _testResult = new TestResult(false, "Pick a reader type first.");
            return;
        }

        _testing = true;
        try
        {
            var existing = ConfigSvc.LoadRouteConfig();
            var probeConfig = _dbForm.ToRouteConfig(existingPassword: existing.Password);
            _testResult = await Task.Run(() =>
            {
                using var reader = service.RadioDataPumpService.CreateReader(probeConfig);
                return reader.TestConnection();
            });
        }
        catch (Exception ex)
        {
            _testResult = new TestResult(false, $"{ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task OnTestApiKey(int destIdx)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        var dest = _destinations[destIdx];

        if (string.IsNullOrWhiteSpace(dest.Destination))
        {
            dest.LastTestResult = new TestResult(false, "Enter a destination URL first.");
            return;
        }
        var keyToProbe = string.IsNullOrEmpty(dest.NewApiKey) ? (dest.ExistingApiKey ?? "") : dest.NewApiKey;
        if (string.IsNullOrEmpty(keyToProbe))
        {
            dest.LastTestResult = new TestResult(false, "Enter an API key to test.");
            return;
        }

        dest.Testing = true;
        dest.LastTestResult = null;
        try
        {
            dest.LastTestResult = await Task.Run(async () =>
            {
                var probe = new GundiV2DataWriter(dest.Destination!, keyToProbe);
                return await probe.TestConnection();
            });
        }
        catch (Exception ex)
        {
            dest.LastTestResult = new TestResult(false, $"{ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            dest.Testing = false;
        }
    }

    private void OnAddAlias(int destIdx)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        _destinations[destIdx].GroupAliases.Add(new GroupAliasFormModel());
        _destinationErrors.Clear();
    }

    private void OnRemoveAlias(int destIdx, int aliasIdx)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        var aliases = _destinations[destIdx].GroupAliases;
        if (aliasIdx < 0 || aliasIdx >= aliases.Count) return;
        aliases.RemoveAt(aliasIdx);
        _destinationErrors.Clear();
    }

    private async Task OnOpenPicker(DestinationFormModel dest)
    {
        // Cache invalidation is owned by ClearTransientStepState (which
        // bumps _fetchGeneration on every step transition). The wizard
        // can't edit DB fields on step 3, so close-and-reopen of the
        // picker should reuse the cached result rather than refetching.
        // No clearing here.
        //
        // No bounds-check on `dest` either: it's an instance reference
        // pulled from the rendered list, not a tampered index. If the
        // caller somehow passed a stale instance, _pickerOpenForDest
        // would just hold a reference that compares unequal to every
        // current list item -- effectively no-op rather than a UI
        // glitch.
        _pickerOpenForDest = dest;
        await EnsureAliasesFetched();
    }

    private void OnClosePicker()
    {
        _pickerOpenForDest = null;
    }

    private void OnTogglePickedAlias(int destIdx, GroupAlias avail)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        var dest = _destinations[destIdx];
        var existing = dest.GroupAliases.FirstOrDefault(a => a.Guid == avail.guid);
        if (existing is not null)
        {
            dest.GroupAliases.Remove(existing);
        }
        else
        {
            dest.GroupAliases.Add(new GroupAliasFormModel
            {
                Guid = avail.guid,
                Alias = avail.alias,
            });
        }
        _destinationErrors.Clear();
    }

    // (IsAliasPicked moved into <DestinationCard> -- it's now computed
    // locally by the component from its own Dest.GroupAliases, so the
    // page no longer needs a callback for the "is this alias already
    // picked?" check.)

    /// <summary>
    /// Fetches available group aliases from the configured source DB
    /// and caches them at page scope. Uses the in-form DB values (same
    /// merge pattern as Test Connection) so the operator can pick
    /// before saving. Idempotent — does nothing if aliases were
    /// already fetched.
    /// </summary>
    private async Task EnsureAliasesFetched()
    {
        if (_availableAliases is not null) return;

        // Re-entrancy guard. Without this, an operator who quickly
        // opens the picker on dest A and then dest B before the first
        // fetch completes could trigger two concurrent DB connections.
        // The in-flight fetch will populate _availableAliases when it
        // completes; both pickers (whichever is currently open) then
        // render the result.
        if (_fetchingAliases) return;

        if (_dbForm.ReaderTypeValue < 0)
        {
            _aliasFetchError = "Pick a reader type first (step 2).";
            return;
        }

        // Snapshot the cache generation. If ClearTransientStepState runs
        // while we're awaiting the fetch (e.g. the operator clicked Back
        // to step 2 before the DB query returned), its bumped generation
        // makes our result stale and we drop it on the floor instead of
        // overwriting whatever fresh state replaced it.
        var generation = _fetchGeneration;
        _fetchingAliases = true;
        _aliasFetchError = null;
        try
        {
            var existing = ConfigSvc.LoadRouteConfig();
            var probeConfig = _dbForm.ToRouteConfig(existingPassword: existing.Password);

            // Off-thread: GetGroupAliases opens a real DB connection.
            var result = await Task.Run(() =>
            {
                using var reader = service.RadioDataPumpService.CreateReader(probeConfig);
                return reader.GetGroupAliases();
            });

            if (generation != _fetchGeneration) return;
            _availableAliases = result;
        }
        catch (Exception ex)
        {
            // Log the full exception (with stack + DB connection details
            // in ex.Message) so support can diagnose from the diagnostic
            // bundle. The UI gets a sanitized message -- DB exceptions
            // from Npgsql / SqlClient routinely embed hostnames,
            // database names, and usernames in the message text and
            // those don't belong in a screenshot.
            NLog.LogManager.GetCurrentClassLogger()
                .Warn(ex, "Failed to fetch group aliases from source DB.");
            if (generation != _fetchGeneration) return;
            _aliasFetchError = "Could not fetch group aliases. " +
                "Check the database settings on step 2 and the service log for details.";
            _availableAliases = null;
        }
        finally
        {
            _fetchingAliases = false;
        }
    }

    // Same shape as Config.razor's ValidateDestinations -- we want the
    // "leave blank" rules, alias rules, and dupe-guid rules to behave
    // identically in the wizard and the manual page. Zero destinations
    // is allowed by virtue of the for-loop simply not executing.
    private static List<string> ValidateDestinations(List<DestinationFormModel> dests)
    {
        var errs = new List<string>();
        for (int i = 0; i < dests.Count; i++)
        {
            var d = dests[i];
            var label = string.IsNullOrWhiteSpace(d.ConnectionName)
                ? $"Destination #{i + 1}"
                : d.ConnectionName;
            if (string.IsNullOrWhiteSpace(d.ConnectionName))
                errs.Add($"{label}: name is required.");
            if (string.IsNullOrWhiteSpace(d.Destination))
                errs.Add($"{label}: URL is required.");
            if (!d.ApiKeySet && string.IsNullOrWhiteSpace(d.NewApiKey))
                errs.Add($"{label}: API key is required.");

            // Per-alias validation. Skip the whole block when the
            // destination is in "send everything" mode -- aliases are
            // ignored at runtime, so blank rows are harmless and we
            // shouldn't make the user clean them up before saving.
            if (!d.SendEverything)
            {
                for (int j = 0; j < d.GroupAliases.Count; j++)
                {
                    var a = d.GroupAliases[j];
                    if (string.IsNullOrWhiteSpace(a.Guid))
                        errs.Add($"{label} alias #{j + 1}: GUID is required.");
                    if (string.IsNullOrWhiteSpace(a.Alias))
                        errs.Add($"{label} alias #{j + 1}: name is required.");
                }

                // GroupAlias.Equals() is by guid -- a duplicate guid in
                // this list would silently overwrite the prior at
                // runtime. Catch it here with a clear error instead.
                var dupes = d.GroupAliases
                    .Where(a => !string.IsNullOrWhiteSpace(a.Guid))
                    .GroupBy(a => a.Guid)
                    .Where(g => g.Count() > 1)
                    .Select(g => g.Key);
                foreach (var dupe in dupes)
                    errs.Add($"{label}: GUID '{dupe}' appears on more than one alias.");
            }
        }
        return errs;
    }
}

