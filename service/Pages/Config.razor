@page "/config"
@using System.ComponentModel.DataAnnotations
@inject ConfigService ConfigSvc
@inject PumpController Controller

<PageTitle>Configuration — Gundi Radio Service</PageTitle>

<div class="card">
    <h2>Database connection</h2>
    <EditForm Model="@_form" OnValidSubmit="OnSave">
        <DataAnnotationsValidator />

        <div class="field">
            <label>Reader type</label>
            <InputSelect @bind-Value="_form.ReaderTypeValue" class="input">
                <option value="-1">— select —</option>
                @foreach (var r in service.RadioDataPumpService.supportedReaders)
                {
                    <option value="@((int)r.Type)">@r.Name</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => _form.ReaderTypeValue)" />
        </div>

        <div class="field">
            <label>Hostname</label>
            <InputText @bind-Value="_form.Hostname" class="input" placeholder="localhost" />
            <ValidationMessage For="@(() => _form.Hostname)" />
        </div>

        <div class="field">
            <label>Database name</label>
            <InputText @bind-Value="_form.DatabaseName" class="input" />
            <ValidationMessage For="@(() => _form.DatabaseName)" />
        </div>

        <div class="field">
            <label>Username</label>
            <InputText @bind-Value="_form.Username" class="input" />
            <ValidationMessage For="@(() => _form.Username)" />
        </div>

        <div class="field">
            <label>Password</label>
            <InputText @bind-Value="_form.NewPassword" class="input" type="password"
                       placeholder="@(_passwordSet ? "(unchanged)" : "")" />
            <small class="hint">Leave blank to keep the existing password.</small>
        </div>

        <div class="field">
            <label>Schema <small class="hint">(PostgreSQL readers only)</small></label>
            <InputText @bind-Value="_form.DatabaseSchema" class="input" placeholder="public" />
        </div>

        <h3 class="section-divider">Pump tuning</h3>

        <div class="field-row">
            <div class="field">
                <label>Batch size</label>
                <InputNumber @bind-Value="_form.BatchSize" class="input" />
            </div>
            <div class="field">
                <label>Interval (ms)</label>
                <InputText @bind-Value="_form.IntervalMs" class="input" />
            </div>
        </div>

        <div class="field-row">
            <div class="field">
                <label>Connection timeout (s)</label>
                <InputNumber @bind-Value="_form.ConnectionTimeoutSeconds" class="input" />
            </div>
            <div class="field">
                <label>Command timeout (s)</label>
                <InputNumber @bind-Value="_form.CommandTimeoutSeconds" class="input" />
            </div>
        </div>

        <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button type="button" class="secondary" @onclick="OnTestConnection" disabled="@_testing">
                @(_testing ? "Testing…" : "Test connection")
            </button>
            <button type="submit">Save</button>
            @if (_savedMessage is not null)
            {
                <span class="saved-msg">@_savedMessage</span>
            }
            @if (_testResult is not null)
            {
                <span class="@(_testResult.Success ? "saved-msg" : "error-msg")">
                    @(_testResult.Success ? "✓" : "✗") @_testResult.Message
                </span>
            }
        </div>
    </EditForm>
</div>

<div class="card">
    <h2>Gundi destinations</h2>
    @if (_destinations.Count == 0)
    {
        <p style="color: #888; font-style: italic;">
            No destinations configured. Click "Add destination" to add one.
        </p>
    }
    else
    {
        @*
            @key keys each card by the destination model instance so
            picker open-state and focus survive add/remove of other
            cards. _pickerOpenForDest is also tracked by instance
            reference for the same reason -- list-index identity drifts
            when items above are removed, instance reference doesn't.
        *@
        @for (int i = 0; i < _destinations.Count; i++)
        {
            // Capture for the lambda closure on Remove — for-loop variable
            // is shared across iterations otherwise.
            int idx = i;
            var dest = _destinations[idx];
            <DestinationCard @key="dest"
                Dest="dest"
                PickerOpen="_pickerOpenForDest == dest"
                FetchingAliases="_inFlightFetch is not null"
                AliasFetchError="@_aliasFetchError"
                AvailableAliases="_availableAliases"
                OnRemove="() => OnRemoveDestination(idx)"
                OnTestApiKey="() => OnTestApiKey(idx)"
                OnAddAlias="() => OnAddAlias(idx)"
                OnRemoveAlias="(j) => OnRemoveAlias(idx, j)"
                OnOpenPicker="() => OnOpenPicker(dest)"
                OnClosePicker="OnClosePicker"
                OnTogglePickedAlias="(avail) => OnTogglePickedAlias(idx, avail)"
            />
        }
    }

    <button type="button" class="secondary" @onclick="OnAddDestination" style="margin-top: 0.75rem;">
        + Add destination
    </button>

    @if (_destinationErrors.Count > 0)
    {
        <div class="error-list">
            @foreach (var err in _destinationErrors)
            {
                <div class="error-msg">@err</div>
            }
        </div>
    }
</div>

<style>
    /* Config-page-specific. Form primitives, destination-card, and
       alias picker styles all live in MainLayout.razor's global block
       since they're shared with the wizard. */
    .field-row { display: flex; gap: 1rem; }
    .field-row .field { flex: 1; }
</style>

@code {
    private DbFormModel _form = new();
    private List<DestinationFormModel> _destinations = new();
    private List<string> _destinationErrors = new();
    private string? _savedMessage;
    private bool _passwordSet;
    private bool _testing;
    private TestResult? _testResult;

    // Group-alias picker state. Page-scoped because all destinations share
    // the same source database — no point fetching per-destination.
    private List<GroupAlias>? _availableAliases;   // null = not yet fetched
    private string? _aliasFetchError;
    // Tracked by instance reference rather than list index because the
    // operator can add/remove destinations while the picker is open;
    // an index would drift, an instance reference doesn't.
    private DestinationFormModel? _pickerOpenForDest;

    // Cache-generation token. Bumped by InvalidateAliasCache() whenever
    // the cache becomes stale (picker re-opened with possibly-new DB
    // form values, or config saved). EnsureAliasesFetched snapshots
    // the value before kicking off its DB query and refuses to write
    // its result if the token has changed by the time the query returns.
    private int _fetchGeneration;

    // Reference to the in-flight fetch Task, if any. EnsureAliasesFetched
    // awaits this rather than racing past it -- otherwise concurrent
    // openings would either start parallel DB connections or leave the
    // picker permanently empty when a stale-discarded result was the
    // only thing in flight. The picker's "Fetching..." indicator is
    // bound directly to (_inFlightFetch is not null) so the UI can't
    // disagree with the actual in-flight state.
    private Task? _inFlightFetch;

    protected override void OnInitialized()
    {
        var current = ConfigSvc.LoadRouteConfig();
        _form = DbFormModel.From(current);
        _passwordSet = !string.IsNullOrEmpty(current.Password);
        _destinations = (current.gundiConnections ?? new())
            .Select(DestinationFormModel.From)
            .ToList();
    }

    private void OnAddDestination()
    {
        _destinations.Add(new DestinationFormModel());
        _destinationErrors.Clear();
        _savedMessage = null;
    }

    private void OnRemoveDestination(int index)
    {
        if (index < 0 || index >= _destinations.Count) return;
        var removed = _destinations[index];
        _destinations.RemoveAt(index);
        // If the operator removes the destination whose picker is open,
        // null out _pickerOpenForDest so it doesn't dangle as a stale
        // reference -- otherwise the next OnOpenPicker won't take its
        // "no picker open" code path on the new card.
        if (ReferenceEquals(_pickerOpenForDest, removed)) _pickerOpenForDest = null;
        _destinationErrors.Clear();
        _savedMessage = null;
    }

    private void OnAddAlias(int destIdx)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        _destinations[destIdx].GroupAliases.Add(new GroupAliasFormModel());
        _destinationErrors.Clear();
        _savedMessage = null;
    }

    private void OnRemoveAlias(int destIdx, int aliasIdx)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        var aliases = _destinations[destIdx].GroupAliases;
        if (aliasIdx < 0 || aliasIdx >= aliases.Count) return;
        aliases.RemoveAt(aliasIdx);
        _destinationErrors.Clear();
        _savedMessage = null;
    }

    private async Task OnTestApiKey(int destIdx)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        var dest = _destinations[destIdx];

        // Validate the in-form fields just enough to attempt a probe; the
        // probe will surface auth/network errors with friendlier messages
        // than letting it fail downstream.
        if (string.IsNullOrWhiteSpace(dest.Destination))
        {
            dest.LastTestResult = new TestResult(false, "Enter a destination URL first.");
            return;
        }
        var keyToProbe = string.IsNullOrEmpty(dest.NewApiKey) ? (dest.ExistingApiKey ?? "") : dest.NewApiKey;
        if (string.IsNullOrEmpty(keyToProbe))
        {
            dest.LastTestResult = new TestResult(false, "Enter an API key to test.");
            return;
        }

        dest.Testing = true;
        dest.LastTestResult = null;
        _savedMessage = null;
        try
        {
            // Off-thread: TestConnection makes a real HTTPS call.
            dest.LastTestResult = await Task.Run(async () =>
            {
                var probe = new GundiV2DataWriter(dest.Destination!, keyToProbe);
                return await probe.TestConnection();
            });
        }
        catch (Exception ex)
        {
            dest.LastTestResult = new TestResult(false, $"{ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            dest.Testing = false;
        }
    }

    private async Task OnOpenPicker(DestinationFormModel dest)
    {
        // Transitioning from "no picker open" to "open" means the user
        // may have edited DB form fields since the last fetch — drop the
        // cache so we re-query against the current values. Switching the
        // open picker from one destination to another reuses the cache,
        // since the source DB is the same for the whole page.
        if (_pickerOpenForDest is null)
        {
            InvalidateAliasCache();
        }
        _pickerOpenForDest = dest;
        await EnsureAliasesFetched();
    }

    /// <summary>
    /// The single point where the alias cache becomes stale. Any code
    /// that nulls <c>_availableAliases</c> should go through here so
    /// the generation token gets bumped in lockstep -- otherwise an
    /// in-flight fetch can come back AFTER the null and write its
    /// (now-stale) result back into the cache.
    ///
    /// Called from <see cref="OnOpenPicker"/> on first-open after a
    /// closed period, and from <see cref="OnSave"/> after persisting
    /// (since saved DB settings may differ from what we cached
    /// aliases against).
    /// </summary>
    private void InvalidateAliasCache()
    {
        _availableAliases = null;
        _aliasFetchError = null;
        _fetchGeneration++;
    }

    private void OnClosePicker()
    {
        _pickerOpenForDest = null;
    }

    private void OnTogglePickedAlias(int destIdx, GroupAlias avail)
    {
        if (destIdx < 0 || destIdx >= _destinations.Count) return;
        var dest = _destinations[destIdx];
        var existing = dest.GroupAliases.FirstOrDefault(a => a.Guid == avail.guid);
        if (existing is not null)
        {
            dest.GroupAliases.Remove(existing);
        }
        else
        {
            dest.GroupAliases.Add(new GroupAliasFormModel
            {
                Guid = avail.guid,
                Alias = avail.alias,
            });
        }
        _destinationErrors.Clear();
        _savedMessage = null;
    }

    // (IsAliasPicked moved into <DestinationCard> -- it's now computed
    // locally by the component from its own Dest.GroupAliases, so the
    // page no longer needs a callback for the "is this alias already
    // picked?" check.)

    /// <summary>
    /// Fetches available group aliases from the configured source DB and
    /// caches them at page scope. Uses the in-form DB values (same merge
    /// pattern as Test Connection) so the user can pick before saving.
    /// Idempotent — does nothing if aliases were already fetched.
    /// </summary>
    private async Task EnsureAliasesFetched()
    {
        // Drain any in-flight fetches before considering whether to
        // start our own. The loop handles two interleavings:
        //
        //   * After the await, the in-flight task populated the cache
        //     (its generation still matched when it returned) -> we
        //     see _availableAliases is not null and return.
        //
        //   * After the await, _availableAliases is still null
        //     because the in-flight discarded its result as stale
        //     (its generation didn't match). Loop: another concurrent
        //     EnsureAliasesFetched call may have ALREADY taken the
        //     fall-through and started a new in-flight fetch in the
        //     window between our pending's continuation running and
        //     our continuation running. If so, await that one too.
        //     Without the loop, multiple awaiting callers can each
        //     fall through and start parallel DB connections --
        //     reintroducing the very concurrency the in-flight slot
        //     is meant to prevent.
        //
        // Exits when either the cache is populated or no in-flight
        // task exists, in which case we're the chosen one to start
        // the next fetch.
        //
        // The Task.Yield() at the bottom is load-bearing: if pending
        // is already completed when we hit `await pending`, the await
        // runs synchronously without yielding to the Blazor sync
        // context. The owning fetch's continuation (which clears
        // _inFlightFetch and may have populated _availableAliases) is
        // queued on the same context and never gets to run while
        // we're spinning. Task.Yield forces a real async yield so
        // queued continuations process before our next iteration.
        while (true)
        {
            if (_availableAliases is not null) return;
            if (_inFlightFetch is not { } pending) break;
            try { await pending; }
            catch { /* the in-flight call handled its own error UI */ }
            await Task.Yield();
        }

        if (_form.ReaderTypeValue < 0)
        {
            _aliasFetchError = "Pick a reader type first.";
            return;
        }

        // Snapshot the cache generation BEFORE kicking off the DB
        // query. If InvalidateAliasCache (called from OnOpenPicker
        // or OnSave) bumps it while we're awaiting, our result is
        // stale and we drop it on the floor instead of overwriting
        // whatever fresh state replaced it.
        var generation = _fetchGeneration;
        var existing = ConfigSvc.LoadRouteConfig();
        var probeConfig = _form.ToRouteConfig(existingPassword: existing.Password);

        _aliasFetchError = null;

        // Off-thread: GetGroupAliases opens a real DB connection.
        // Stash the task in _inFlightFetch so a concurrent
        // EnsureAliasesFetched can await it instead of skipping past
        // and missing the populate. Note: the picker UI's
        // "Fetching..." state is derived directly from
        // (_inFlightFetch is not null) -- no separate boolean to
        // keep in sync.
        var task = Task.Run(() =>
        {
            using var reader = service.RadioDataPumpService.CreateReader(probeConfig);
            return reader.GetGroupAliases();
        });
        _inFlightFetch = task;
        try
        {
            var result = await task;
            if (generation != _fetchGeneration) return;
            _availableAliases = result;
        }
        catch (Exception ex)
        {
            if (generation != _fetchGeneration) return;
            _aliasFetchError = $"{ex.GetType().Name}: {ex.Message}";
            _availableAliases = null;
        }
        finally
        {
            // Only clear the slot if it's still ours -- a follow-up
            // EnsureAliasesFetched may have already replaced it
            // (which is what the loop at the top of this method
            // intentionally enables). Without the ReferenceEquals
            // check, "still fetching" would visually flicker off
            // mid-cycle even though a newer fetch is underway.
            if (ReferenceEquals(_inFlightFetch, task)) _inFlightFetch = null;
        }
    }

    private void OnSave()
    {
        // The DataAnnotationsValidator already passed for the DB form (this
        // is OnValidSubmit). Validate destinations manually — each one's
        // editable fields aren't part of _form, so they aren't covered.
        _destinationErrors = ValidateDestinations(_destinations);
        if (_destinationErrors.Count > 0)
        {
            _savedMessage = null;
            return;
        }

        var existing = ConfigSvc.LoadRouteConfig();
        RouteConfiguration updated;
        try
        {
            updated = _form.ToRouteConfig(existingPassword: existing.Password);
        }
        catch (InvalidOperationException ex)
        {
            // ToRouteConfig throws on form-level invariants we don't cover
            // with DataAnnotations -- e.g. an unknown ReaderTypeValue from a
            // tampered request. Surface the message via the same error
            // channel the destinations use; the operator can correct and
            // re-save.
            _destinationErrors = new List<string> { ex.Message };
            _savedMessage = null;
            return;
        }
        updated.gundiConnections = _destinations.Select(d => d.ToConnection()).ToList();

        ConfigSvc.SaveRouteConfig(updated);
        Controller.RequestReload();

        // Acknowledge the saved API keys so the UI shows "(unchanged)" on
        // next edit instead of forcing the user to re-enter them.
        foreach (var d in _destinations) d.AcceptApiKey();

        // The saved DB may differ from what we cached aliases against.
        // Invalidate so the next picker open re-fetches. Going through
        // the helper bumps the fetch generation too, so an
        // EnsureAliasesFetched mid-Save can't write its (pre-Save)
        // result back into the cache after we cleared it.
        InvalidateAliasCache();

        _passwordSet = !string.IsNullOrEmpty(updated.Password);
        _form.NewPassword = "";
        _testResult = null;
        _savedMessage = "Saved. Pump reloading with the new settings.";
    }

    private static List<string> ValidateDestinations(List<DestinationFormModel> dests)
    {
        var errs = new List<string>();
        for (int i = 0; i < dests.Count; i++)
        {
            var d = dests[i];
            var label = string.IsNullOrWhiteSpace(d.ConnectionName)
                ? $"Destination #{i + 1}"
                : d.ConnectionName;
            if (string.IsNullOrWhiteSpace(d.ConnectionName))
                errs.Add($"{label}: name is required.");
            if (string.IsNullOrWhiteSpace(d.Destination))
                errs.Add($"{label}: URL is required.");
            if (!d.ApiKeySet && string.IsNullOrWhiteSpace(d.NewApiKey))
                errs.Add($"{label}: API key is required.");

            // Per-alias validation. Skip the whole block when the
            // destination is in "send everything" mode — aliases are
            // ignored at runtime, so blank rows are harmless and we
            // shouldn't make the user clean them up before saving.
            if (!d.SendEverything)
            {
                for (int j = 0; j < d.GroupAliases.Count; j++)
                {
                    var a = d.GroupAliases[j];
                    if (string.IsNullOrWhiteSpace(a.Guid))
                        errs.Add($"{label} alias #{j + 1}: GUID is required.");
                    if (string.IsNullOrWhiteSpace(a.Alias))
                        errs.Add($"{label} alias #{j + 1}: name is required.");
                }

                // GroupAlias.Equals() is by guid — a duplicate guid in this
                // list would silently overwrite the prior at runtime. Catch
                // it here with a clear error instead.
                var dupes = d.GroupAliases
                    .Where(a => !string.IsNullOrWhiteSpace(a.Guid))
                    .GroupBy(a => a.Guid)
                    .Where(g => g.Count() > 1)
                    .Select(g => g.Key);
                foreach (var dupe in dupes)
                    errs.Add($"{label}: GUID '{dupe}' appears on more than one alias.");
            }
        }
        return errs;
    }

    private async Task OnTestConnection()
    {
        _savedMessage = null;
        _testResult = null;

        // Don't bother attempting a connection if we know it'll fail on
        // a missing reader type — the underlying factory throws and the
        // user gets a confusing exception instead of a clean message.
        if (_form.ReaderTypeValue < 0)
        {
            _testResult = new TestResult(false, "Pick a reader type first.");
            return;
        }

        _testing = true;
        try
        {
            var existing = ConfigSvc.LoadRouteConfig();
            var probeConfig = _form.ToRouteConfig(existingPassword: existing.Password);

            // TestConnection() opens a real connection on the calling thread.
            // Off-load to the threadpool so the SignalR render thread stays
            // responsive while the connect attempt is in flight.
            _testResult = await Task.Run(() =>
            {
                using var reader = service.RadioDataPumpService.CreateReader(probeConfig);
                return reader.TestConnection();
            });
        }
        catch (Exception ex)
        {
            _testResult = new TestResult(false, $"{ex.GetType().Name}: {ex.Message}");
        }
        finally
        {
            _testing = false;
        }
    }

    // Form-model classes (DbFormModel, DestinationFormModel,
    // GroupAliasFormModel) live in service/SetupFormModels.cs so the
    // first-run Setup wizard can share the exact same shapes.
}
